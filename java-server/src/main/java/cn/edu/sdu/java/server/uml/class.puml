@startuml
' 校医院预约挂号系统 - 领域实体类图
' 依据当前 models 包与数据库表结构绘制
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

package "认证与基础数据" {
    class Person <<person>> {
        - personId : Integer
        - num : String
        - name : String
        - type : String
        - dept : String
        - card : String
        - gender : String
        - birthday : String
        - email : String
        - phone : String
        - address : String
        - introduce : String
        - photo : byte[]
    }

    class User <<user>> {
        - personId : Integer
        - userName : String
        - password : String
        - loginCount : Integer
        - lastLoginTime : String
        - createTime : String
        - creatorId : Integer
    }

    class UserType <<user_type>> {
        - id : Integer
        - name : String
    }

    enum EUserType {
        ROLE_ADMIN
        ROLE_DOCTOR
        ROLE_PATIENT
        ROLE_STUDENT
        ROLE_TEACHER
    }

    class DictionaryInfo <<dictionary>> {
        - id : Integer
        - pid : Integer
        - value : String
        - label : String
    }

    class SystemInfo <<system_info>> {
        - id : Integer
        - name : String
        - value : String
        - des : String
    }

    class ModifyLog <<modify_log>> {
        - id : Integer
        - type : String
        - tableName : String
        - info : String
        - operateTime : String
        - operatorId : Integer
    }
}

package "预约挂号业务" {
    class Department <<t_department>> {
        - id : Integer
        - deptName : String
    }

    class Doctor <<t_doctor>> {
        - id : Integer
        - userId : Integer
        - deptId : Integer
        - title : String
        - introduction : String
    }

    class Schedule <<t_schedule>> {
        - id : Integer
        - doctorId : Integer
        - workDate : LocalDate
        - timeSlot : Integer
        - totalQuota : Integer
        - remainQuota : Integer
    }

    class Appointment <<t_appointment>> {
        - id : Integer
        - patientId : Integer
        - scheduleId : Integer
        - status : Integer
        - createTime : LocalDateTime
    }

    class MedicalRecord <<t_medical_record>> {
        - id : Integer
        - appointmentId : Integer
        - symptom : String
        - diagnosis : String
        - prescription : String
        - createTime : LocalDateTime
    }
}

Person "1" -- "0..1" User : personId
User "*" --> "1" UserType : userTypeId
UserType ..> EUserType : name

Department "1" -- "0..*" Doctor : deptId
Doctor "1" -- "0..*" Schedule : doctorId
Schedule "1" -- "0..*" Appointment : scheduleId
Appointment "1" -- "0..1" MedicalRecord : appointmentId
User "1" -- "0..*" ModifyLog : operatorId

note right of Doctor
  userId（逻辑外键）
  关联 user.person_id，医生登录账号
end note

note right of Appointment
  patientId（逻辑外键）
  关联 user.person_id，患者登录账号
  status：0 待诊 / 1 已就诊 / 2 已取消
end note

note right of Schedule
  timeSlot：1 上午 / 2 下午
  remainQuota 由挂号、取消、修改总号数维护
end note

@enduml
